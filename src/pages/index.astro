---
import Layout from '../layouts/Layout.astro';
import logoMark from '../assets/brand/logo-mark.svg';
import logoWordmark from '../assets/brand/logo-wordmark.svg';
---

<Layout>
	<main class="foundation-check">
		<img src={logoMark.src} width="64" height="64" alt="" class="mark" />
		<img src={logoWordmark.src} width="180" height="60" alt="Glide" class="wordmark" />

		<h1>Foundation check</h1>
		<p class="sub">
			Fonts, colors, and spacing tokens are wired up. Phase 2 replaces this page with the
			real hero, feature sections, and footer.
		</p>

		<div class="swatches">
			<span class="swatch" style="background: var(--glide-500)"></span>
			<span class="swatch" style="background: var(--sage-500)"></span>
			<span class="swatch" style="background: var(--apricot-500)"></span>
			<span class="swatch" style="background: var(--lilac-500)"></span>
		</div>

		<div class="type-check">
			<span class="display">Bricolage Grotesque</span>
			<span class="body">Hanken Grotesk</span>
			<span class="mono">JetBrains Mono · 24:59</span>
		</div>

		<span class="cta">Coming soon</span>
	</main>
</Layout>

<style>
	.foundation-check {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-4);
		padding: var(--space-8) var(--page-pad);
		text-align: center;
	}

	.mark {
		border-radius: var(--radius-md);
	}

	.wordmark {
		height: 40px;
		width: auto;
	}

	h1 {
		font-size: var(--text-display);
		margin-top: var(--space-4);
	}

	.sub {
		color: var(--text-muted);
		max-width: 32rem;
		line-height: var(--leading-relaxed);
	}

	.swatches {
		display: flex;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.swatch {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-sm);
	}

	.type-check {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-2);
	}

	.display {
		font-family: var(--font-display);
		font-size: var(--text-h2);
		font-weight: var(--weight-bold);
		color: var(--text-strong);
	}

	.body {
		font-family: var(--font-body);
		color: var(--text-body);
	}

	.mono {
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.cta {
		margin-top: var(--space-6);
		display: inline-flex;
		align-items: center;
		background: var(--primary);
		color: var(--text-on-primary);
		font-weight: var(--weight-semibold);
		padding: var(--space-3) var(--space-6);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-glide);
	}
</style>
